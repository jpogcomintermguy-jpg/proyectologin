<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Imagen de Fondo (DOOM: The Dark Ages) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/img"
        android:scaleType="centerCrop" />

    <!-- Overlay Oscuro para dar contraste y legibilidad -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0B0606" />

    <!-- Contenedor Principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center">

        <!-- Título Gótico / Medieval -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" WELCOME "
            android:textColor="#E52B20"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:fontFamily="serif"
            android:shadowColor="#FF0000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12"
            android:layout_marginBottom="36dp" />

        <!-- Campo Usuario -->
        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="USERNAME"
            android:textColorHint="#8A8A8A"
            android:textColor="#FFFFFF"
            android:background="#331A1A1A"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="16dp" />

        <!-- Campo Contraseña -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="PASSCODE"
            android:textColorHint="#8A8A8A"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:background="#331A1A1A"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="32dp" />

        <!-- Botón LOGIN / INGRESAR -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="LOGIN"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:backgroundTint="#8B0000"
            android:layout_marginBottom="12dp" />

        <!-- Botón REGISTER / REGISTRARSE -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="REGISTER"
            android:textColor="#D4AF37"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:backgroundTint="#1F1B18"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</RelativeLayout>